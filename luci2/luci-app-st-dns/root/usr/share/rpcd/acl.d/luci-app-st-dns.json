{
	"luci-app-st-dns": {
		"description": "Grant access to LuCI app st-dns",
		"read": {
			"uci": [
				"st-dns",
				"dhcp"
			],
			"cgi-io": [
				"exec"
			],
			"ubus": {
				"st-dns": [
					"dns_queue_list"
				]
			},
			"file": {
				"/etc/st/dns/*": [
					"read"
				],
				"/etc/config/st-dns": [
					"read"
				],
				"/etc/init.d/st-dns": [
					"exec"
				],
				"/etc/init.d/dnsmasq": [
					"exec"
				]
			}
		},
		"write": {
			"uci": [
				"st-dns",
				"dhcp"
			],
			"file": {
				"/etc/st/dns/*": [
					"write"
				],
				"/etc/config/st-dns": [
					"write"
				],
				"/etc/config/dnsmasq.servers": [
					"write"
				]
			}
		}
	}
}